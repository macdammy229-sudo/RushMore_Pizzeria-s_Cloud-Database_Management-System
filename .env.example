import os
import random
from datetime import datetime, timedelta

import psycopg2
from faker import Faker
from psycopg2 import sql
from psycopg2.extras import execute_batch

fake = Faker("en_US")

STORES = 4
MENU_ITEMS = 25
INGREDIENTS = 45
CUSTOMERS = 6500
ORDERS = 30000
TARGET_ORDER_ITEMS = 75000


def get_db_config():
    required = [
        "AZURE_DB_HOST",
        "AZURE_DB_NAME",
        "AZURE_DB_USER",
        "AZURE_DB_PASSWORD",
    ]
    config = {key: os.getenv(key) for key in required}
    missing = [key for key, value in config.items() if not value]
    if missing:
        raise RuntimeError(
            "Missing required database settings: " + ", ".join(missing)
            + ". Copy .env.example to .env and populate the Azure connection values."
        )

    config["port"] = os.getenv("AZURE_DB_PORT", "5432")
    return config


def get_connection():
    cfg = get_db_config()
    return psycopg2.connect(
        host=cfg["AZURE_DB_HOST"],
        dbname=cfg["AZURE_DB_NAME"],
        user=cfg["AZURE_DB_USER"],
        password=cfg["AZURE_DB_PASSWORD"],
        port=cfg["port"],
        sslmode="require",
    )


def insert_rows(cur, table_name, columns, values):
    if not values:
        return
    placeholders = ", ".join(["%s"] * len(columns))
    col_sql = ", ".join(columns)
    query = sql.SQL("INSERT INTO {} ({}) VALUES ({})").format(
        sql.Identifier(table_name),
        sql.SQL(", ").join(map(sql.Identifier, columns)),
        sql.SQL(placeholders),
    )
    execute_batch(cur, query.as_string(cur), values, page_size=500)


def seed_stores(cur):
    rows = []
    cities = ["Seattle", "Portland", "Denver", "Austin"]
    addresses = [
        "1201 Pine St",
        "216 Broadway Ave",
        "789 Market St",
        "4500 5th Ave",
    ]
    phone_prefixes = ["206", "503", "303", "512"]
    for i in range(STORES):
        rows.append(
            (
                addresses[i],
                cities[i],
                f"{phone_prefixes[i]}-{random.randint(100, 999)}-{random.randint(1000, 9999)}",
                datetime.now() - timedelta(days=random.randint(365, 3650)),
            )
        )
    insert_rows(cur, "stores", ["address", "city", "phone_number", "opened_at"], rows)
    return rows


def seed_ingredients(cur):
    ingredient_names = [
        "Mozzarella Cheese", "Pepperoni", "Pizza Dough", "Tomato Sauce", "Olive Oil",
        "Basil", "Red Onions", "Bell Peppers", "Mushrooms", "Spinach", "Chicken",
        "Italian Sausage", "Ham", "Bacon", "Pineapple", "Jalapeno", "Garlic",
        "Parmesan", "Oregano", "Feta Cheese", "Arugula", "Sweet Corn", "Black Olives",
        "Anchovies", "Beef", "Lime", "Lemon", "Cucumber", "Tomato", "Lettuce",
        "Cabbage", "Romaine", "Broccoli", "Carrots", "Green Beans", "Avocado",
        "Guacamole", "Salsa", "Cilantro", "Cumin", "Paprika", "Chili Flakes",
        "Butter", "Milk", "Cream", "Flour", "Sugar", "Vanilla",
    ]
    rows = []
    for name in ingredient_names[:INGREDIENTS]:
        rows.append((name, round(random.uniform(50, 2500), 2), random.choice(["kg", "liters", "units", "bags"])))
    insert_rows(cur, "ingredients", ["name", "stock_quantity", "unit"], rows)
    return rows


def seed_menu_items(cur):
    menu_data = [
        ("Large Pepperoni Pizza", "Pizza", "Large", 18.99),
        ("Large Margherita Pizza", "Pizza", "Large", 17.49),
        ("Medium Pepperoni Pizza", "Pizza", "Medium", 15.99),
        ("Medium Margherita Pizza", "Pizza", "Medium", 15.49),
        ("Large Veggie Supreme", "Pizza", "Large", 19.99),
        ("Large Meat Lovers", "Pizza", "Large", 20.99),
        ("Large Hawaiian Pizza", "Pizza", "Large", 18.49),
        ("Large BBQ Chicken Pizza", "Pizza", "Large", 21.99),
        ("Large Four Cheese Pizza", "Pizza", "Large", 18.99),
        ("Large Buffalo Chicken Pizza", "Pizza", "Large", 22.49),
        ("Large Supreme Pizza", "Pizza", "Large", 22.99),
        ("Small Cheese Pizza", "Pizza", "Small", 11.99),
        ("Medium Cheese Pizza", "Pizza", "Medium", 13.99),
        ("Large Garlic Knots", "Side", "Large", 8.99),
        ("Classic Caesar Salad", "Side", "Regular", 9.49),
        ("Garden Salad", "Side", "Regular", 8.99),
        ("House Fries", "Side", "Regular", 5.49),
        ("Chocolate Brownie", "Dessert", "Single", 4.99),
        ("Lemonade", "Drink", "500ml", 3.49),
        ("Coca-Cola", "Drink", "500ml", 3.29),
        ("Sparkling Water", "Drink", "500ml", 2.99),
        ("Iced Tea", "Drink", "500ml", 3.49),
        ("Espresso", "Drink", "Regular", 3.99),
        ("Cheese Bread", "Side", "Large", 10.49),
        ("Stuffed Calzone", "Pizza", "Large", 16.49),
        ("Glazed Donut", "Dessert", "Single", 3.99),
    ]

    rows = []
    for name, category, size, price in menu_data:
        rows.append((name, category, size, price))
    insert_rows(cur, "menu_items", ["name", "category", "size", "price"], rows)

    cur.execute("SELECT item_id, name FROM menu_items ORDER BY item_id")
    return cur.fetchall()


def seed_menu_item_ingredients(cur, ingredient_lookup):
    rows = []
    cur.execute("SELECT item_id, name FROM menu_items ORDER BY item_id")
    menu_items = cur.fetchall()
    for item_id, name in menu_items:
        selected = random.sample(list(ingredient_lookup.items()), random.randint(2, 6))
        for ingredient_name, ingredient_id in selected:
            rows.append((item_id, ingredient_id, round(random.uniform(0.1, 3.5), 2), random.choice(["kg", "liters", "units", "cups"])))
    insert_rows(cur, "menu_item_ingredients", ["menu_item_id", "ingredient_id", "quantity", "unit"], rows)


def seed_customers(cur):
    customers = []
    for _ in range(CUSTOMERS):
        first = fake.first_name()
        last = fake.last_name()
        email = fake.email()
        phone = fake.phone_number()[:20]
        created_at = fake.date_time_this_decade()
        customers.append((first, last, email, phone, created_at))
    insert_rows(cur, "customers", ["first_name", "last_name", "email", "phone_number", "created_at"], customers)


def seed_orders(cur):
    order_rows = []
    for _ in range(ORDERS):
        customer_id = random.randint(1, CUSTOMERS)
        store_id = random.randint(1, STORES)
        order_timestamp = fake.date_time_this_year()
        total_amount = round(random.uniform(10, 60), 2)
        order_rows.append((customer_id, store_id, order_timestamp, total_amount))
    insert_rows(cur, "orders", ["customer_id", "store_id", "order_timestamp", "total_amount"], order_rows)


def seed_order_items(cur):
    cur.execute("SELECT item_id, price FROM menu_items ORDER BY item_id")
    menu_items = cur.fetchall()
    cur.execute("SELECT order_id FROM orders ORDER BY order_id")
    orders = [row[0] for row in cur.fetchall()]

    order_items = []
    for order_id in orders:
        for _ in range(random.randint(2, 3)):
            item_id, unit_price = random.choice(menu_items)
            quantity = random.randint(1, 2)
            order_items.append((order_id, item_id, quantity, round(float(unit_price), 2)))

    insert_rows(cur, "order_items", ["order_id", "item_id", "quantity", "unit_price"], order_items)


def main():
    conn = get_connection()
    cur = conn.cursor()

    try:
        seed_stores(cur)
        ingredient_rows = seed_ingredients(cur)
        ingredient_lookup = {name: ingredient_id for ingredient_id, name in enumerate([row[0] for row in ingredient_rows], start=1)}
        seed_menu_items(cur)
        seed_menu_item_ingredients(cur, ingredient_lookup)
        seed_customers(cur)
        seed_orders(cur)
        seed_order_items(cur)
        conn.commit()
        print("RushMore data load complete.")
        cur.execute("SELECT COUNT(*) FROM stores")
        print("Stores:", cur.fetchone()[0])
        cur.execute("SELECT COUNT(*) FROM customers")
        print("Customers:", cur.fetchone()[0])
        cur.execute("SELECT COUNT(*) FROM orders")
        print("Orders:", cur.fetchone()[0])
        cur.execute("SELECT COUNT(*) FROM order_items")
        print("Order items:", cur.fetchone()[0])
    finally:
        cur.close()
        conn.close()


if __name__ == "__main__":
    main()
